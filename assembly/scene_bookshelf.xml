<!--
  Bookshelf scene for the librarian demo: UR10e + 2F-140 + blade gripper at the origin (assembly/ur10e_2f140.xml),
  desk, bookshelf with two tiers of books, room, lights, cameras. World frame = UR base frame, metres.
  Textures: python scripts_sim/make_scene_textures.py  ->  assembly/textures/*.png

  Layout
    desk    top x -0.75..0.75, y -0.45..1.20, z -0.04..0 (robot bolted at the origin); steel legs to the floor z = -0.74
    room    floor plane z = -0.74, back wall plane y = 1.45, side wall plane x = -1.3 (backdrop; nothing touches them)
    shelf   open front toward -y, no top board; side panels x +-0.36..+-0.34, y 0.80..1.10, z 0..0.70;
            back panel y 1.09..1.10; plinth z 0..0.095 (y 0.82..1.09); bottom board top z = 0.12 and middle board top
            z = 0.42 (both x -0.34..0.34, y 0.80..1.09)
    books   free bodies (freejoint named like the body), one collision box geom named like the body, spines toward -y,
            every spine face at y = 0.82, standing on a board; friction 0.5, mass 0.25-1.0 kg (paper, 650 kg/m3)
      upper   book_target 0.040 x 0.170 x 0.230 (x, y, z) centred at (0, 0.905, 0.535), 0.80 kg; its neighbours
              book_L1 / book_R1 leave exactly 10 mm of air on each side (faces at x = -0.030 and +0.030);
              book_L2.. / book_R2.. packed outward with 0.5-1 mm gaps (thickness 0.020-0.045, height 0.19-0.25,
              depth 0.15-0.18); steel bookends bookend_L / bookend_R 4 mm past the last book
      lower   book_low_01..13 standing on the bottom board (heights 0.20-0.26, 0.5-1 mm gaps) and book_flat_1..3
              lying in a stack at the right end
    Spine bands, labels and page blocks are visual-only geoms (no contact, no mass), at most 0.5 mm proud of the box.
    The arm works in x -0.5..0.5, y -0.2..0.85, z 0..1.3; only the shelf front (y >= 0.80) reaches into that box.

  Cameras (fixed, xyaxes computed from the look-at points)
    cam_main   3/4 view from the front-left: whole robot, desk and shelf
    cam_close  upper tier around book_target, 0.5 m in front of the shelf and a hand's width right of the target:
               both 10 mm gaps, the page tops and the shelf front edge. A front-left camera is blocked at the
               home pose (tool at x = -0.17, y = 0.69 and the wrist sit on the sight line to the target)
    cam_side   from the robot's left at shelf-front height: gripper in profile in front of the shelf
-->
<mujoco model="ur10e_2f140_bookshelf">
  <include file="ur10e_2f140.xml"/>

  <statistic center="0 0.55 0.1" extent="1.6"/>

  <visual>
    <quality shadowsize="4096" offsamples="8"/>
    <global azimuth="60" elevation="-20" offwidth="1920" offheight="1080"/>
    <headlight ambient="0.46 0.46 0.46" diffuse="0.08 0.08 0.08" specular="0 0 0"/>
    <rgba haze="0.80 0.80 0.78 1"/>
    <!-- tight shadow-map depth range: the default (1) leaves speckle on the desk top at 3 m; 0.16 keeps full shadows -->
    <map shadowclip="0.16"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.82 0.82 0.80" rgb2="0.70 0.70 0.69" width="32" height="512"/>
    <texture name="desk_wood" type="2d" file="textures/desk_wood.png"/>
    <texture name="shelf_wood" type="2d" file="textures/shelf_wood.png"/>
    <texture name="shelf_wood_v" type="2d" file="textures/shelf_wood_v.png"/>
    <texture name="floor" type="2d" file="textures/floor.png"/>
    <texture name="wall" type="2d" file="textures/wall.png"/>
    <texture name="book_cloth" type="2d" file="textures/book_cloth.png"/>
    <texture name="book_paper" type="2d" file="textures/book_paper.png"/>

    <material name="desk_wood" texture="desk_wood" specular="0.25" shininess="0.3"/>
    <material name="shelf_wood" texture="shelf_wood" specular="0.2" shininess="0.25"/>
    <material name="shelf_wood_v" texture="shelf_wood_v" specular="0.2" shininess="0.25"/>
    <material name="floor" texture="floor" texrepeat="10 10" rgba="0.78 0.78 0.77 1" specular="0.15" shininess="0.2"/>
    <material name="wall" texture="wall" texrepeat="10 2.6" rgba="0.98 0.97 0.94 1" specular="0.02" shininess="0.05"/>
    <material name="baseboard" rgba="0.93 0.92 0.89 1" specular="0.1" shininess="0.2"/>
    <material name="steel" rgba="0.15 0.15 0.16 1" specular="0.5" shininess="0.4"/>
    <material name="bookend" rgba="0.24 0.25 0.27 1" specular="0.6" shininess="0.5"/>
    <material name="book_cloth" texture="book_cloth" specular="0.08" shininess="0.1"/>
    <material name="paper" texture="book_paper" rgba="0.93 0.90 0.80 1" specular="0.02" shininess="0.05"/>
    <material name="gold" rgba="0.80 0.62 0.20 1" specular="0.6" shininess="0.7"/>
    <material name="silver" rgba="0.72 0.73 0.75 1" specular="0.6" shininess="0.7"/>
    <material name="label_cream" rgba="0.86 0.81 0.68 1" specular="0.05" shininess="0.1"/>
    <material name="ink" rgba="0.07 0.065 0.06 1" specular="0.05" shininess="0.1"/>
  </asset>

  <default>
    <default class="furniture">
      <geom friction="0.5 0.005 0.0001" solref="0.004 1"/>
    </default>
    <default class="steel">
      <geom type="box" friction="0.4 0.005 0.0001" solref="0.004 1"/>
    </default>
    <!-- every book: one collision box, 0.5 friction (paper on wood), stiff contact so books do not sink -->
    <default class="book">
      <geom type="box" material="book_cloth" friction="0.5 0.005 0.0001" condim="4" solref="0.004 1"/>
    </default>
    <default class="book_low">
      <geom type="box" material="book_cloth" friction="0.5 0.005 0.0001" condim="3" solref="0.004 1"/>
    </default>
    <!-- visual-only spine bands, labels, page blocks: no contacts, no mass, at most 0.5 mm proud of the box -->
    <default class="deco">
      <geom type="box" contype="0" conaffinity="0" mass="0"/>
    </default>
  </default>

